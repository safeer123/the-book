rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for a signed-in user who has a doc at /admins/{uid}.
    // Membership is managed directly in the Firestore console (or via the
    // Admin SDK) — never through a client write, see the `admins` rules
    // below.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may only fetch their OWN admin doc (to decide
    // whether to show admin UI client-side) — they can never list the
    // collection or read anyone else's doc, so the admin list can't be
    // enumerated. Nobody can write here from the client.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // Recitation-binding projects (path taken from
    // REACT_APP_STORAGE_PATH_TO_DOCUMENT in .env). Readable by anyone —
    // this powers the public /suras, /qbind and /mqbind pages — but only
    // writable by an admin, since this is what backs the Recitation
    // Timeline Editor and Project Manager pages.
    match /verse-bind-docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /playground-fb-db's CRUD test collection — any signed-in user, not
    // admin-gated, since it's a scratch feature rather than real data.
    match /posts/{postId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
