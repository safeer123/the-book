rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A doc existing at admins/{uid} grants that user admin rights. No
    // admin emails/uids live in this rules file — add/remove admins by
    // creating/deleting a doc in the Firebase Console's Data tab, keyed by
    // the user's Auth UID (Authentication > Users).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may only check their OWN admin doc (get), never
    // list the collection — so nobody can enumerate who else is an admin.
    // Writes happen out-of-band via the Console, not through the app.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Recitation-binding projects (path taken from
    // REACT_APP_STORAGE_PATH_TO_DOCUMENT in .env). Readable by anyone —
    // this powers the public /suras, /qbind and /mqbind pages — but only
    // writable by an admin, since this is what backs the Recitation
    // Timeline Editor and Project Manager pages.
    match /verse-bind-docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /playground-fb-db's CRUD test collection — any signed-in user, not
    // admin-gated, since it's a scratch feature rather than real data.
    match /posts/{postId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
