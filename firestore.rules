rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors the FE allowlist in src/data/use-is-admin.ts — keep both in
    // sync. request.auth.token.email comes straight off the ID token, so
    // this needs no extra Firestore lookup/collection.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'safeer2c@gmail.com',
          'dumpfolders2c@gmail.com'
        ];
    }

    // Recitation-binding projects (path taken from
    // REACT_APP_STORAGE_PATH_TO_DOCUMENT in .env). Readable by anyone —
    // this powers the public /suras, /qbind and /mqbind pages — but only
    // writable by an admin, since this is what backs the Recitation
    // Timeline Editor and Project Manager pages.
    match /verse-bind-docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /playground-fb-db's CRUD test collection — any signed-in user, not
    // admin-gated, since it's a scratch feature rather than real data.
    match /posts/{postId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
